# Pi Media Station — copier en « .env » dans le dossier de données (~/.local/share/pi-media/.env)
# puis remplir. Ce fichier contient des secrets : il ne doit jamais être publié.

# --- Serveur Subsonic ---
SUBSONIC_URL=https://musique.example.org
SUBSONIC_USER=
SUBSONIC_PASS=

# --- Clés facultatives (on peut aussi les saisir dans l'application) ---
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
EXT_JAMENDO_ID=
EXT_YOUTUBE_KEY=
EXT_YOUTUBE_REGION=FR

# --- Saisie depuis le téléphone ---
PHONE_REMOTE=true
PHONE_PORT=8100

# --- Menu tactile ---
DEVICE_NAME=Salon
WEATHER_CITY=Lyon
WEATHER_LATITUDE=45.764
WEATHER_LONGITUDE=4.836
SCREENSAVER_SECONDS=120
# Thème du menu : fichier themes/<nom>.yaml (retro par défaut)
THEME=retro

# --- Langue des textes (fichier i18n/<langue>.yaml) ---
LANGUAGE=fr
