# Réglages Docker de l'édition PC. Copier en « .env » (même dossier) et adapter : un .env par machine
# (ton poste de test, le serveur). Le .env n'est jamais publié ni copié dans une image (.gitignore, .dockerignore).

# Adresse du serveur Subsonic, vue depuis le conteneur (127.0.0.1 y désigne le conteneur lui-même, jamais l'hôte).
# - Subsonic dans un conteneur sur la même machine : rejoindre son réseau (bloc « Subsonic en conteneur » plus bas) et
#   http://<nom du conteneur Subsonic>:4040 ;
# - Subsonic sur la même machine, hors Docker (ou port publié sur toutes les interfaces) : http://host.docker.internal:4040
SUBSONIC_URL=https://musique.exemple.fr

# Adresse de Subsonic vue par les personnes, pour les liens de la page « Mon compte » (Last.fm, mot de passe).
# Seulement si SUBSONIC_URL est une adresse interne (http://subsonic:4040…) ; vide : SUBSONIC_URL.
SUBSONIC_PUBLIC_URL=

# Port de la machine où le site écoute (127.0.0.1 seulement). Le port dans le conteneur reste 8200.
WEB_HOST_PORT=8200

# true dès que le site est servi en HTTPS (prod) ; false en simple http:// (test), sinon la connexion échoue.
WEB_SECURE_COOKIE=true

# true derrière Apache, nginx ou Traefik : l'adresse de chaque personne (limite des essais de connexion) est lue dans
# X-Forwarded-For. Sans cela, toutes les requêtes viennent du proxy et 8 essais ratés bloqueraient tout le monde.
# false seulement si le site est joint directement, sans proxy.
WEB_TRUST_PROXY=true

# Mémoire maximale du site (les envois passent par petits morceaux : 512m suffit). Au-delà, seul le conteneur est arrêté
# puis relancé, au lieu d'étouffer toute la machine.
WEB_MEM_LIMIT=512m

# Port de la démonstration (docker compose --profile demo up demo).
DEMO_HOST_PORT=8300

# Édition Pi sur le poste de développement (docker compose --profile pi up pi ; poste de test seulement).
# Le Pi n'a qu'un compte Subsonic : le sien. Vides : à saisir dans le conteneur
# (docker compose exec -it pi bash /opt/pi-media/deploy.sh --configure).
# PI_SUBSONIC_URL : seulement si différente de SUBSONIC_URL.
PI_SUBSONIC_URL=
PI_SUBSONIC_USER=
PI_SUBSONIC_PASS=
PI_HOST_PORT=8399
# Même chose avec le faux Subsonic de démonstration (docker compose --profile pi-demo up pi-demo).
PI_DEMO_HOST_PORT=8499

# Musique d'ailleurs, UNE clé par source pour tout le site (vide = source désactivée).
# Jamendo : identifiant client gratuit sur devportal.jamendo.com. YouTube : clé « YouTube Data API v3 »
# (console.cloud.google.com) ; elle ne change ni les résultats ni la publicité, seulement le quota
# (environ 100 recherches par jour pour tout le site ; 20 par personne et par heure au plus).
EXT_JAMENDO_ID=
EXT_YOUTUBE_KEY=
EXT_YOUTUBE_REGION=FR

# Changer la pochette d'un album (crayon sur la page album, droit Subsonic « upload ») : clé d'API Last.fm, gratuite sur
# last.fm/api (la même que celle de Subsonic convient). Vide : la recherche est désactivée, seule une adresse d'image marche.
# L'image est écrite en cover.jpg dans le dossier de l'album (MUSIC_DIR, monté en écriture).
LASTFM_API_KEY=

# Catalogues des labels, découverte musicale et discographies. Jeton personnel Discogs (paramètres développeur).
# Il reste sur le serveur, n'est jamais envoyé au navigateur. Vide : Discogs désactivé.
DISCOGS_API_KEY=

# Utilisateur de l'hôte sous lequel tourne le site : le MÊME que celui de Subsonic, propriétaire de la musique
# (« id music » sur le serveur donne uid et gid). Les fichiers envoyés lui appartiennent. Changer ces valeurs demande une
# reconstruction (docker compose up -d --build web).
APP_UID=1000
APP_GID=1000

# Envoi de fichiers (page « Envoyer », droit Subsonic « upload ») : la RACINE de la musique, telle qu'elle est sur CETTE
# machine (le dossier que Subsonic voit sur /var/music avec l'image gzurowski/subsonic), montée en écriture dans le
# conteneur. Vide : datas/Music à côté de compose.yaml (test en local, à créer : mkdir -p datas/Music).
# Un zip envoyé est décompressé dans <MUSIC_DIR>/<INCOMING_NAME>, puis chaque album qui respecte la nomenclature
# Artiste/Album/titre (ou Artiste/Album/CD1/titre ; majuscule au début de l'artiste et de l'album) part aussitôt dans
# <MUSIC_DIR>/Artiste/Album : il rejoint l'artiste s'il existe (majuscules et accents mis à part : « Dalek » → « Dälek »).
# Le reste (titre seul, artiste inconnu, hors nomenclature, album déjà présent) attend dans Incoming.
MUSIC_DIR=
INCOMING_NAME=Incoming
# Un album corrigé à la main dans Incoming (Incoming/Artiste/Album) est rangé après ce nombre d'heures sans changement.
# 0 = jamais (seuls les envois sont rangés).
INCOMING_WAIT_HOURS=1

# Dossiers de la racine de la musique épinglés en haut de la barre des artistes (séparés par des virgules), ex. le
# dossier qui regroupe les compilations (Compilations/Album/titre). Un nom absent de la bibliothèque est ignoré.
SHORTCUT_FOLDERS=Compilations

# --- Subsonic en conteneur sur le serveur : décommenter (compose.subsonic.yaml) ---
# Le site rejoint le réseau Docker de Subsonic ; SUBSONIC_URL=http://<nom du conteneur Subsonic>:4040
# COMPOSE_FILE=compose.yaml:compose.subsonic.yaml
# SUBSONIC_NETWORK=subsonic

# --- Test en local derrière Traefik (pas en prod) : décommenter ---
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
# WEB_DOMAIN=pimedia.localhost
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
